{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repo Stealer Desktop",
  "version": "0.1.0-alpha.3",
  "identifier": "com.hrishi072.repostealer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Repo Stealer", "width": 1320, "height": 940, "minWidth": 900, "minHeight": 700, "center": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Encrypted repository capture, recovery and backups",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] }, "rpm": { "depends": [] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
